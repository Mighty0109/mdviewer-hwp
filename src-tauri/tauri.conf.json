{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDViewer",
  "version": "0.1.0",
  "identifier": "com.mighty.mdviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDViewer",
        "width": 1200,
        "height": 820,
        "minWidth": 680,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown document",
        "description": "Markdown text document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ],
    "macOS": { "minimumSystemVersion": "10.15", "signingIdentity": "-" }
  }
}
